{
  "rules": {
    "AdminUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "DeviceRegistry": {
      ".read": "auth != null",

      "$deviceId": {
        ".read": "auth != null",

        ".write": "auth != null && (\n          root.child('AdminUsers').child(auth.uid).val() === true ||\n          !data.exists() ||\n          !data.child('owner').exists() ||\n          data.child('owner').val() === '' ||\n          data.child('owner').val() === auth.uid\n        )"
      }
    },

    "Doofarm": {
      ".read": "auth != null && root.child('AdminUsers').child(auth.uid).val() === true",

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('AdminUsers').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",

        "Profile": {
          "expoPushToken": {
            ".validate": "newData.isString()"
          }
        },

        "devices": {
          "$deviceId": {
            ".write": "auth != null && (auth.uid === $uid || root.child('AdminUsers').child(auth.uid).val() === true)"
          }
        },

        "$planId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('AdminUsers').child(auth.uid).val() === true)",
          "Settings": {
            ".write": "auth != null && (auth.uid === $uid || root.child('AdminUsers').child(auth.uid).val() === true)"
          },
          "Pump": {
            ".write": "auth != null && (auth.uid === $uid || root.child('AdminUsers').child(auth.uid).val() === true)"
          },
          "ActivityLogs": {
            ".write": "auth != null && (auth.uid === $uid || root.child('AdminUsers').child(auth.uid).val() === true)"
          }
        }
      }
    }
  }
}
